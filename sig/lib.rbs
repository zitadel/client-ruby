# Hand-written RBS for the keep-listed (hand-written) sources.
#
# The code generator emits signatures only for the files it generates
# (sig/infrastructure.rbs, sig/vendor.rbs and the per-model/per-api files under
# sig/zitadel/). The bespoke, keep-listed sources have no generated signature,
# so their types are declared here:
#   - lib/zitadel/client/auth/*.rb             (the bespoke authenticators)
#   - lib/zitadel/client/errors/oauth2_*.rb    (the OAuth2 error types)
#
# This file also provides the plain `module Zitadel` / `module Client` namespace
# anchor. Every generated signature uses the qualified `module Zitadel::Client`
# form, and RBS only resolves `::Zitadel::...` references once the outer
# namespace is declared with the nested form.
#
# Types owned by the generated signatures (Configuration, ApiClient, ApiError,
# TransportOptions, module Api, module Models, VERSION, Auth::Authenticator,
# Auth::BaseAuthenticator, Auth::HttpAwareAuthenticator) are intentionally NOT
# redeclared here.
module Zitadel
  module Client
    module Errors
      class OAuth2ServerError < ::Zitadel::Client::ZitadelError
        attr_reader status_code: Integer
        attr_reader code: String?
        attr_reader description: String?
        attr_reader uri: String?
        attr_reader raw_body: String

        def initialize: (Integer status_code, String? code, String? description, String? uri, String raw_body) -> void

        def self.build_message: (Integer status_code, String? code, String? description, String raw_body) -> String
      end

      class OAuth2TokenError < ::Zitadel::Client::ZitadelError
      end
    end

    module Auth
      class OpenId
        WELL_KNOWN_PATH: String
        STATUS_ERRORS: Hash[Integer, untyped]

        attr_reader host_endpoint: String

        @well_known_url: String
        @token_endpoint: String?
        @mutex: Thread::Mutex

        def initialize: (String? host) -> void

        def token_endpoint: (ApiClient api_client) -> String

        private

        def normalise_host: (String? host) -> String

        def validate_host: (String host) -> String

        def discover: (ApiClient api_client) -> String

        def token_endpoint_from: (Hash[String, untyped] document, String url) -> String

        def parse_document: (String body, String url) -> Hash[String, untyped]

        def status_error: (Integer status, String message, ApiHttpResponse response) -> ApiError
      end

      class NoAuthAuthenticator < BaseAuthenticator
        attr_reader host: String

        def initialize: (?String host) -> void

        def auth_headers: () -> Hash[String, String]
      end

      class PersonalAccessTokenAuthenticator < BaseAuthenticator
        attr_reader host: String

        @token: String

        def initialize: (String host, String token) -> void

        def auth_headers: () -> Hash[String, String]

        def inspect: () -> String

        def to_s: () -> String
      end

      class OAuthAuthenticator < BaseAuthenticator
        include HttpAwareAuthenticator

        REFRESH_SKEW_SECONDS: Integer
        TOKEN_REQUEST_HEADERS: Hash[String, String]

        attr_reader scope: String

        @open_id: OpenId
        @scope: String
        @api_client: ApiClient?
        @access_token: String?
        @expires_at: Float?
        @mutex: Thread::Mutex

        def initialize: (OpenId open_id, String scope) -> void

        def api_client=: (ApiClient client) -> void

        def host: () -> String

        def auth_headers: () -> Hash[String, String]

        def auth_token: () -> String

        def refresh_token: () -> String

        def inspect: () -> String

        def to_s: () -> String

        def grant_type: () -> String

        def token_request_params: () -> Hash[String, String]

        def masked_token: () -> String?

        private

        def stale?: () -> bool

        def mint_token: () -> String

        def cache_token: (Hash[String, untyped] payload) -> String

        def post_token_request: () -> ApiHttpResponse

        def injected_api_client: () -> ApiClient

        def parse_object: (String body) -> Hash[String, untyped]?

        def server_error: (Integer status, String body) -> Errors::OAuth2ServerError
      end

      class OAuthAuthenticatorBuilder
        DEFAULT_SCOPE: String

        attr_reader open_id: OpenId
        attr_reader scope: String

        def initialize: (String host) -> void

        def scopes: (*String auth_scopes) -> self

        def self.require_text: (untyped value, String label) -> String
      end

      class ClientCredentialsAuthenticator < OAuthAuthenticator
        GRANT_TYPE: String

        attr_reader client_id: String

        @client_secret: String

        def initialize: (OpenId open_id, String client_id, String client_secret, String scope) -> void

        def self.builder: (String host, String client_id, String client_secret) -> ClientCredentialsAuthenticatorBuilder
      end

      class ClientCredentialsAuthenticatorBuilder < OAuthAuthenticatorBuilder
        @client_id: String
        @client_secret: String

        def initialize: (String host, String client_id, String client_secret) -> void

        def build: () -> ClientCredentialsAuthenticator
      end

      class WebTokenAuthenticator < OAuthAuthenticator
        GRANT_TYPE: String
        ALGORITHMS: Array[String]

        class JwtAssertion
          attr_reader issuer: String
          attr_reader subject: String
          attr_reader audience: String
          attr_reader private_key: OpenSSL::PKey::RSA
          attr_reader lifetime: Integer
          attr_reader algorithm: String
          attr_reader key_id: String?

          def self.new: (issuer: String, subject: String, audience: String, private_key: OpenSSL::PKey::RSA, lifetime: Integer, algorithm: String, key_id: String?) -> JwtAssertion
        end

        @assertion: JwtAssertion

        def initialize: (OpenId open_id, String scope, JwtAssertion assertion) -> void

        def self.from_json: (String host, String json_path) -> WebTokenAuthenticator

        def self.read_key_file: (String json_path) -> Hash[String, untyped]

        def self.read_file: (String json_path) -> String

        def self.parse_json: (String content) -> untyped

        def self.builder: (String host, String user_id, String private_key) -> WebTokenAuthenticatorBuilder

        private

        def encode_assertion: (JwtAssertion assertion) -> String
      end

      class WebTokenAuthenticatorBuilder < OAuthAuthenticatorBuilder
        @user_id: String
        @private_key: OpenSSL::PKey::RSA
        @lifetime: Integer
        @algorithm: String
        @key_id: String?

        def initialize: (String host, String user_id, String private_key) -> void

        def token_lifetime_seconds: (Integer seconds) -> self

        def jwt_algorithm: (String jwt_algorithm) -> self

        def key_id: (String key_id) -> self

        def build: () -> WebTokenAuthenticator

        private

        def load_private_key: (String pem) -> OpenSSL::PKey::RSA
      end
    end
  end
end
